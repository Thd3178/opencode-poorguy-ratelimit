{
  // 插件总开关
  "enabled": true,
  
  // 轮询策略：round-robin | least-used | random
  "strategy": "round-robin",
  
  // 需要轮询的provider配置
  "providers": {
    "nvidia-nim": {
      "keys": [
        "sk-your-key-1",
        "sk-your-key-2"
      ],
      "rpm": 40
    },
    "other-provider": {
      "keys": [
        "sk-your-other-key"
      ],
      "rpm": 60
    }
  },

  // 429 冷却：无 Retry-After 头时从 baseDelayMs 指数翻倍，封顶 maxDelayMs
  "backoff": {
    "baseDelayMs": 5000,
    "maxDelayMs": 120000
  },

  // 日志配置（写 ~/.config/opencode/opencode-poorguy-ratelimit.log）
  "logging": {
    "enabled": true
  }
}
